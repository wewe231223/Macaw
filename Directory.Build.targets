<Project>
  <Import Project="$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.targets" Condition="Exists('$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.targets')" />
  <Target Name="CheckDependencies" BeforeTargets="PrepareForBuild" Condition="!Exists('$(VcpkgRoot)vcpkg.exe')">
    <Error Text="Run Build.bat from the repository root to prepare tools, restore dependencies, and generate the solution." />
  </Target>
</Project>
